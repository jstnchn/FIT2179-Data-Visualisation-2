            "axis": {
              "title": "Expenditure (RM million)",
              "titleFont": "DM Sans",
              "titleFontSize": 12,
              "labelFont": "DM Sans",
              "labelFontSize": 11,
              "grid": false,
              "format": ".2s",
              "domain": true
            }
          },
          "y2": {
            "field": "value"
          },
          "color": {
            "field": "type",
            "type": "nominal",
            "scale": {
              "domain": [
                "start",
                "gain",
                "loss",
                "end"
              ],
              "range": [
