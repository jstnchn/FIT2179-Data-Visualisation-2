    "layer": [
      {
        "mark": {
          "type": "bar",
          "cornerRadiusEnd": 3
        },
        "encoding": {
          "x": {
            "field": "year",
            "type": "ordinal",
            "sort": [
              "2017",
              "2018",
              "2019",
              "2020",
              "2021",
              "2022",
              "2023",
              "2024"
            ],
            "axis": {
              "title": "Year",
              "titleFont": "DM Sans",
              "titleFontSize": 12,
