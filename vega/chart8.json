              "field": "year",
              "type": "ordinal",
              "title": "Year"
            },
            {
              "field": "value",
              "type": "quantitative",
              "title": "Expenditure (RM million)",
              "format": ","
            },
            {
              "field": "change",
              "type": "quantitative",
              "title": "Change (RM million)",
              "format": "+"
            }
          ]
        }
      },
      {
        "mark": {
          "type": "text",
          "align": "center",
          "baseline": "bottom",
          "dy": -4,
          "fontSize": 10,
          "font": "DM Sans",
          "fontStyle": "italic",
          "color": "#555555"
        },
        "transform": [
          {
            "filter": "datum.type === 'start' || datum.type === 'end'"
          }
        ],
        "encoding": {
          "x": {
            "field": "year",
            "type": "ordinal"
          },
          "y": {
            "field": "value",
            "type": "quantitative"
          },
          "text": {
            "field": "value",
            "type": "quantitative",
            "format": ","
          }
        }
      },
      {
        "mark": {
          "type": "text",
          "align": "center",
          "baseline": "bottom",
          "dy": -4,
          "fontSize": 10,
          "font": "DM Sans",
          "fontStyle": "italic",
          "color": "#333333"
        },
        "transform": [
          {
            "filter": "datum.type === 'gain'"
          },
          {
            "calculate": "'+RM' + format(datum.change, ',')",
            "as": "label"
          }
        ],
        "encoding": {
          "x": {
            "field": "year",
            "type": "ordinal"
          },
          "y": {
            "field": "value",
            "type": "quantitative"
          },
          "text": {
            "field": "label",
            "type": "nominal"
          }
        }
      },
      {
        "mark": {
          "type": "text",
          "align": "center",
          "baseline": "bottom",
          "dy": -4,
          "fontSize": 10,
          "font": "DM Sans",
          "fontStyle": "italic",
          "color": "#333333"
        },
        "transform": [
          {
            "filter": "datum.type === 'loss'"
          },
          {
            "calculate": "format(datum.change, ',')",
            "as": "label"
          }
        ],
        "encoding": {
          "x": {
            "field": "year",
            "type": "ordinal"
          },
          "y": {
            "field": "base",
            "type": "quantitative"
          },
          "text": {
            "field": "label",
            "type": "nominal"
          }
        }
      }
    ],
    "config": {
      "background": "transparent",
      "view": {
        "stroke": "transparent"
      }
    }
  }