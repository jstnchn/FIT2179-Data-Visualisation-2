  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2,
        "opacity": 0.8
      },
      "params": [
        {
          "name": "country_select",
          "select": {
            "type": "point",
            "fields": [
              "country"
            ]
          },
          "bind": "legend"
        }
      ],
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "axis": {
            "title": "Year",
            "titleFont": "DM Sans",
            "titleFontSize": 12,
            "labelFont": "DM Sans",
            "labelFontSize": 11,
            "labelAngle": -45,
            "grid": false
          }
        },
        "y": {
          "field": "arrivals",
          "type": "quantitative",
          "axis": {
            "title": "Arrivals",
            "titleFont": "DM Sans",
            "titleFontSize": 12,
            "labelFont": "DM Sans",
            "labelFontSize": 11,
            "grid": false,
            "format": ".2s"
          }
        },
        "color": {
          "field": "country",
          "type": "nominal",
          "scale": {
            "domain": [
              "Singapore",
              "Indonesia",
              "China",
              "Thailand",
              "Brunei",
              "India",
              "Philippines",
              "South Korea"
            ],
            "range": [
              "#0072B2",
              "#E69F00",
              "#CC79A7",
              "#009E73",
              "#56B4E9",
              "#D55E00",
              "#F0E442",
              "#999999"
            ]
          },
          "legend": {
            "title": "Country",
            "titleFont": "DM Sans",
            "labelFont": "DM Sans",
            "titleFontSize": 12,
            "labelFontSize": 11,
            "orient": "bottom"
          }
        },
        "opacity": {
          "condition": {
            "param": "country_select",
            "value": 1
          },
          "value": 0.1
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 80,
        "opacity": 1
      },
      "encoding": {
        "opacity": {
          "condition": {
            "param": "country_select",
            "value": 1
          },
          "value": 0.1
        },
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "arrivals",
          "type": "quantitative"
        },
        "color": {
          "field": "country",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "arrivals",
            "type": "quantitative",
            "title": "Arrivals",
            "format": ","
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2024"
        }
