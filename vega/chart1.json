{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 420,
  "projection": { "type": "equalEarth" },
  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@v1.29.0/data/world-110m.json",
        "format": { "type": "topojson", "feature": "graticules" }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#cccccc",
        "strokeWidth": 0.4
      }
    },
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@v1.29.0/data/world-110m.json",
        "format": { "type": "topojson", "feature": "countries" }
      },
      "transform": [
        {
          "lookup": "id",
          "from": {
            "data": { "url": "data/arrivals_by_country.csv" },
            "key": "id",
            "fields": ["total_arrivals", "name", "iso3"]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 0.5
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.total_arrivals == null",
            "value": "#e8e4de"
          },
          "field": "total_arrivals",
          "type": "quantitative",
          "scale": {
            "type": "log",
            "scheme": "oranges",
            "domain": [1000, 50000000]
          },
          "legend": {
            "title": "Total Arrivals (2020–2024)",
            "orient": "bottom-right",
            "format": ".2s",
            "titleFontSize": 10,
            "labelFontSize": 9
          }
        },
        "tooltip": [
          { "field": "name", "type": "nominal", "title": "Country" },
          { "field": "total_arrivals", "type": "quantitative", "title": "Total Arrivals", "format": "," }
        ]
      }
    },
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@v1.29.0/data/world-110m.json",
        "format": { "type": "topojson", "feature": "land" }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#999999",
        "strokeWidth": 0.3
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": { "stroke": "transparent" }
  }
}
